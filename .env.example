# Copy to .env for local development. .env is gitignored; never commit real values.
#
# In AWS none of these secrets are set directly: the Lambda gets
# NOTES_JWT_SECRET_PARAM and NOTES_TEAM_TOKENS_PARAM instead and reads both from
# SSM Parameter Store at cold start.

NOTES_TABLE_NAME=note-taking-local
NOTES_DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Any value of at least 32 characters. Locally it only needs to be consistent.
NOTES_JWT_SECRET=local-development-signing-key-not-a-secret

# The team token registry. Records may carry a plaintext `token`, as here, or a
# `token_sha256` digest, which is what the deployed registry holds.
NOTES_TEAM_TOKENS=[{"team_id":"acme","token":"nt_local-development-token-for-acme-team"},{"team_id":"globex","token":"nt_local-development-token-for-globex-team"},{"team_id":"initech","token":"nt_local-development-token-for-initech-team"},{"team_id":"umbrella","token":"nt_local-development-token-for-umbrella-team"}]

# Raise these while poking at the API by hand so you do not throttle yourself.
NOTES_RATE_LIMIT_REQUESTS=1000
NOTES_AUTH_RATE_LIMIT_REQUESTS=100

NOTES_LOG_LEVEL=INFO

# DynamoDB Local ignores the values but boto3 refuses to start without them.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
